<?xml version="1.0" encoding="utf-8"?>
<!--
  VSIX manifest for Ctrl+T Navigator for C++.

  Layout of the produced .vsix container (assembled by pack-vsix.ps1):
    extension.vsixmanifest          this file, detokenized/copied as-is
    CtrlTNav.pkgdef                 generated by CreatePkgDef.exe from the package attributes
    CtrlTNav.Vsix.dll               the VSPackage assembly (Menus.ctmenu resource embedded)
    CtrlTNav.Core.dll               contracts / models / options
    CtrlTNav.Matching.dll           fuzzy matching + search index + MRU
    CtrlTNav.Indexing.dll           C++ symbol extraction + solution scanning
    CtrlTNav.UI.dll                 WPF popup (loaded from the extension folder)
    Resources\logo.png              extension icon (128x128)
    Resources\license.txt           licence shown by the VSIX installer
    Resources\getting-started.txt   short usage notes

  Only a VsPackage asset is declared: all managed dependencies sit next to the package assembly and
  are resolved at runtime through [ProvideBindingPath] on the package class, so they must NOT be
  listed as Microsoft.VisualStudio.Assembly assets (that would install them into a shared folder).
-->
<PackageManifest Version="3.0.0"
                 xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">

  <Metadata>
    <Identity Id="CtrlTNav.GoToEverything"
              Version="1.0.0"
              Language="en-US"
              Publisher="CtrlTNav" />
    <DisplayName>Ctrl+T Navigator for C++</DisplayName>
    <Description xml:space="preserve">ReSharper-style Go to Everything for Visual Studio C/C++ development. Press Ctrl+T (or Ctrl+,) to search types, symbols, macros and files with fuzzy matching, smart ranking and recent-usage weighting.</Description>
    <MoreInfo>https://github.com/ctrltnav/CtrlTNav</MoreInfo>
    <License>Resources\license.txt</License>
    <GettingStartedGuide>Resources\getting-started.txt</GettingStartedGuide>
    <Icon>Resources\logo.png</Icon>
    <Tags>c++; cpp; navigation; Go to Everything; Ctrl+T; ReSharper; fuzzy search; symbol search; visual studio</Tags>
    <Preview>false</Preview>
  </Metadata>

  <Installation>
    <!-- 17.0 = Visual Studio 2022, 18.0/19.0 covers Visual Studio 2026 and later 18.x/19.x servicing updates. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>

  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>

  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>

  <Assets>
    <!-- The package is registered through the generated pkgdef; everything else is loaded from this folder. -->
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="CtrlTNav.pkgdef" />
  </Assets>

</PackageManifest>
